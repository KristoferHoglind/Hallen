# Example only. Set the actual value in Render's Environment dashboard.
# Use Supabase Connect -> Session pooler (IPv4), port 5432, not transaction mode.
ConnectionStrings__DefaultConnection=Host=YOUR-POOLER-HOST;Port=5432;Database=postgres;Username=postgres.YOUR-PROJECT-REF;Password=YOUR-DATABASE-PASSWORD;SSL Mode=VerifyFull;Maximum Pool Size=10;Timeout=15
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=10000
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
Database__MigrateOnStartup=true
